# Bon Voyage Pakistan - Testing Environment Variables
# Copy this file to .env and set your own values:
# cp .env.example .env

# Groq AI API Key for Trip Planning & testing
GROQ_API_KEY_TripPlan=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key for audio / image / AI testing
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
