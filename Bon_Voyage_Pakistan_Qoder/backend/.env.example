# Bon Voyage Pakistan - Backend Environment Variables
# Copy this file to .env and set your own values:
# cp .env.example .env

# JWT secret key - CHANGE THIS to a secure random string in production
SECRET_KEY=your-super-secret-jwt-key-here

# JWT token expiration time in hours
JWT_EXPIRATION_HOURS=24

# Groq AI API Key (Priority: GROQ_API_KEY_TripPlan -> GROQ_API_KEY)
GROQ_API_KEY_TripPlan=your_groq_api_key_here
GROQ_API_KEY=

# Google Gemini API Key (Priority: GEMINI_API_KEY -> GoogleAPI -> GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here
GoogleAPI=
GOOGLE_API_KEY=

# Gemini Model
GEMINI_MODEL=gemini-3.6-flash

# CORS Allowed Origins (* or comma-separated list)
CORS_ORIGINS=*
